{
  "description": "cc-harness — mirrors session lifecycle into the review UI and delivers the user's answers back into the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["SessionStart"], "timeout": 20 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["SessionEnd"], "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["UserPromptSubmit"], "timeout": 25 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["PostToolUse"], "timeout": 15 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["PostToolUseFailure"], "timeout": 15 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["Notification"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["Stop"], "timeout": 600 }
        ]
      }
    ]
  }
}

{
  "description": "cc-harness — registers sessions with the planning UI and, when the user has changed the plan in the browser, tells Claude to read it. Never blocks or holds a turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["SessionStart"], "timeout": 20 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["SessionEnd"], "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["UserPromptSubmit"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-relay.sh", "args": ["Stop"], "timeout": 5 }
        ]
      }
    ]
  }
}

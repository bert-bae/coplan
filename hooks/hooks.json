{
  "description": "Coplan \u2014 registers sessions with the planning UI, notices when Claude is waiting on the user so the UI can link back to the session, and tells Claude when the plan changed. Never blocks or holds a turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "SessionStart"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "SessionEnd"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "UserPromptSubmit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "PreToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "PostToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "Notification"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/coplan-hook-relay.sh",
            "args": [
              "Stop"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

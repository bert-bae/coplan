{
  "name": "coplan",
  "version": "0.3.0",
  "description": "Open-source visual planning workspace for Claude Code, Codex and Cursor: shape the agent's plan as architecture diagrams and a task board in the browser, submit it, and follow the build.",
  "license": "MIT",
  "author": "Elbert B.",
  "homepage": "https://github.com/bert-bae/coplan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bert-bae/coplan.git"
  },
  "bugs": {
    "url": "https://github.com/bert-bae/coplan/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "planning",
    "architecture",
    "diagrams",
    "tasks",
    "mcp",
    "codex",
    "codex-plugin",
    "cursor",
    "cursor-plugin"
  ],
  "type": "module",
  "bin": {
    "coplan": "dist/cli/main.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "bin",
    "commands",
    "hooks",
    "mcp",
    "skills",
    "dist/cli",
    "dist/daemon",
    "dist/mcp",
    "dist/ui",
    "dist/artifact",
    "dist/version.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prepare": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@tailwindcss/node": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^13.0.1",
    "esbuild": "^0.28.2",
    "html-to-image": "1.11.13",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

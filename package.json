{
  "name": "coplan",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source visual planning workspace for Claude Code, Codex and Cursor: shape the agent's plan as architecture diagrams and a task board in the browser, submit it, and follow the build.",
  "license": "MIT",
  "author": "Elbert B.",
  "homepage": "https://github.com/bert-bae/coplan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bert-bae/coplan.git"
  },
  "bugs": {
    "url": "https://github.com/bert-bae/coplan/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "planning",
    "architecture",
    "diagrams",
    "tasks",
    "mcp",
    "codex",
    "codex-plugin",
    "cursor",
    "cursor-plugin"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prepare": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xyflow/react": "^12.8.4",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}

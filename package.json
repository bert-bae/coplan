{
  "name": "cc-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Visual planning workspace for live Claude Code sessions",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm run build && npm run test",
    "prepare": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xyflow/react": "^12.8.4",
    "esbuild": "^0.24.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}

{
  // Coplan's own checks: what every task of a change planned with Coplan
  // runs in its implement → review → refine cycle. `coplan check <stage>`
  // runs a stage; CI runs the same commands.
  "hooks": {
    "implement": [
      { "name": "typecheck", "run": "pnpm typecheck" }
    ],
    "review": [
      { "name": "build and test", "run": "pnpm build && pnpm test", "timeout": 900 }
    ],
    "final": [
      { "name": "check", "run": "pnpm check", "timeout": 1200 },
      { "name": "doctor", "run": "CC_HARNESS_HOME=\"$(mktemp -d)\" sh -c './bin/coplan doctor; s=$?; ./bin/coplan stop; exit $s'", "timeout": 300 }
    ]
  },
  // How a build runs by default; the submit dialog can change it per plan.
  // Setting `iric` makes builds here Managed by default.
  "iric": { "review": "subagent", "parallel": 2, "maxRounds": 3 },
  "branches": { "base": "main" }
}

{
  // Coplan's own checks: each task's definition of done, for a change
  // planned with Coplan. `coplan check <stage>` runs a stage, targeted to
  // what changed; CI runs the same commands.
  // The tests read the skills, the docs and the golden prompts, so they run
  // on any change; the typecheck only when TypeScript or its config does.
  "checks": {
    "implement": [
      { "name": "typecheck", "run": "pnpm typecheck", "paths": ["*.ts", "*.tsx", "tsconfig.json", "package.json", "pnpm-lock.yaml"] }
    ],
    "review": [
      { "name": "build and test", "run": "pnpm build && pnpm test", "timeout": 900 }
    ],
    "final": [
      { "name": "check", "run": "pnpm check", "timeout": 1200 },
      { "name": "doctor", "run": "CC_HARNESS_HOME=\"$(mktemp -d)\" sh -c './bin/coplan doctor; s=$?; ./bin/coplan stop; exit $s'", "timeout": 300 }
    ]
  },
  "branches": { "base": "main" }
}
